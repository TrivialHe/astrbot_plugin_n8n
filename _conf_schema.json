{
  "n8n": {
    "description": "N8N WEBHOOK 配置",
    "type": "object",
    "items": {
      "adminIds": {
        "description": "允许的发送者 ID，逗号分隔；精确匹配，不填写群号或会话标识。",
        "type": "string",
        "default": ""
      },
      "n8n_webhook_url": {
        "description": "N8N 监听地址,比如 https://your-domain/webhook/path",
        "type": "string",
        "default": "http://n8n:5678/webhook/astrbot-maa"
      },
      "username": {
        "description": "Basic Auth username",
        "type": "string",
        "default": "test"
      },
      "password": {
        "description": "Basic Auth password",
        "type": "string",
        "default": ""
      },
      "allowedPlatformIds": {
        "description": "自动化入口平台 ID，逗号分隔。仅开放 QQ 官方与微信。",
        "type": "string",
        "default": ""
      }
    }
  }
}
